; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Frontier Blocks 3D"
config/description="3D Real-Time Strategy with voxel-inspired low-poly aesthetics"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameSettings="*res://scripts/autoload/GameSettings.gd"
NetworkManager="*res://scripts/autoload/NetworkManager.gd"
EventBus="*res://scripts/autoload/EventBus.gd"
EconomyManager="*res://scripts/autoload/EconomyManager.gd"
SoundManager="*res://scripts/autoload/SoundManager.gd"

[debug]

gdscript/warnings/enable=false
gdscript/warnings/inference_on_variant=0

[display]

window/size/viewport_width=1672
window/size/viewport_height=941
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1

